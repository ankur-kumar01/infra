# Single source of truth for all domains served by this host's nginx.
# Change a domain here AND in the matching nginx/<app>.conf server_name +
# snippet include name, in the same commit.
#
# Also update the port registry in README.md when adding apps.

FINZOX_DOMAIN="finzox.live"
AVIATOR_DOMAIN="aviator.finzox.live"
ERP_DOMAIN="erp.finzox.live"

# Comma-separated list used by loops in sync.sh.
ALL_DOMAINS="$FINZOX_DOMAIN,$AVIATOR_DOMAIN,$ERP_DOMAIN"

# Certbot renewal contact (only used on FIRST issuance)
CERTBOT_EMAIL="admin@finzox.live"
